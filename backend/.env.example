# Copy this to .env and fill in your values

# Database
# For Supabase Postgres (standard URI or Session pooler URI; postgresql:// or postgresql+asyncpg://):
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# For local SQLite development:
# DATABASE_URL=sqlite+aiosqlite:///./sais.db

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=SAIS
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173

# AI Provider Configuration
# Provider: "gemini" (default, cloud) or "ollama" (local)
AI_PROVIDER=gemini

# Gemini AI (Cloud)
# Specific keys take precedence; falls back to GEMINI_API_KEY if specific key is empty.
GEMINI_API_KEY_CHAT=
GEMINI_API_KEY_TIMETABLE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Per-user AI rate limit per hour (returns 429 when exceeded)
AI_RATE_LIMIT_PER_HOUR=30

# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Classroom OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Optional Fernet key for token encryption (leave empty to derive from SECRET_KEY)
TOKEN_ENCRYPTION_KEY=

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
